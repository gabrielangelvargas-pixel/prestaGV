<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PrestaGV.App</RootNamespace>
    <AssemblyName>PrestaGV</AssemblyName>
    <StartupObject>PrestaGV.App.Program</StartupObject>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml como Page: el Main lo define Program.cs para que Velopack se ejecute primero. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrestaGV.Core\PrestaGV.Core.csproj" />
    <ProjectReference Include="..\PrestaGV.Data\PrestaGV.Data.csproj" />
  </ItemGroup>

</Project>
